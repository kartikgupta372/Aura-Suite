{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCal",
  "version": "1.0.0",
  "identifier": "com.auraventures.deskcal",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "DeskCal", "width": 1180, "height": 800, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Aura Ventures",
    "shortDescription": "A calendar that reminds you.",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
